@model ACMaintenanceTracker.Models.ACUnit

@{
    ViewData["Title"] = "AC Unit Information";
    Layout = null; // Remove layout for cleaner QR code display
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            padding: 20px;
        }

        .ac-card {
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            margin-bottom: 20px;
        }

        .maintenance-badge {
            font-size: 0.9rem;
            margin-right: 5px;
            margin-bottom: 5px;
        }

        .status-indicator {
            width: 15px;
            height: 15px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 5px;
        }

        .status-good {
            background-color: #28a745;
        }

        .status-warning {
            background-color: #ffc107;
        }

        .status-danger {
            background-color: #dc3545;
        }

        .info-label {
            font-weight: 600;
            color: #495057;
        }

        .info-value {
            color: #212529;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="ac-card card">
                    <div class="card-header bg-primary text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="mb-0">@Model.ACIdentifier</h3>
                            @{
                                var statusClass = "";
                                var statusText = "";
                                var latestMaintenance = Model.MaintenanceRecords?.OrderByDescending(r => r.MaintenanceDate).FirstOrDefault();

                                if (latestMaintenance != null && latestMaintenance.NextMaintenanceDate.HasValue)
                                {
                                    if (latestMaintenance.NextMaintenanceDate.Value < DateTime.Today)
                                    {
                                        statusClass = "status-danger";
                                        statusText = "Maintenance Overdue";
                                    }
                                    else if (latestMaintenance.NextMaintenanceDate.Value < DateTime.Today.AddDays(30))
                                    {
                                        statusClass = "status-warning";
                                        statusText = "Maintenance Due Soon";
                                    }
                                    else
                                    {
                                        statusClass = "status-good";
                                        statusText = "Maintained";
                                    }
                                }
                                else
                                {
                                    statusClass = "status-warning";
                                    statusText = "Maintenance Unknown";
                                }
                            }
                            <span class="badge bg-light text-dark">
                                <span class="@statusClass"></span>@statusText
                            </span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <p class="mb-2">
                                    <span class="info-label">Location:</span>
                                    <span class="info-value">Floor @Model.FloorNumber, Room @(Model.RoomNumber ?? "N/A")</span>
                                </p>
                                <p class="mb-2">
                                    <span class="info-label">Model:</span>
                                    <span class="info-value">@(Model.Model ?? "Not specified")</span>
                                </p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-2">
                                    <span class="info-label">Installed:</span>
                                    <span class="info-value">@(Model.InstallationDate?.ToString("MMMM d, yyyy") ?? "Unknown")</span>
                                </p>
                                <p class="mb-2">
                                    <span class="info-label">Maintenance Records:</span>
                                    <span class="info-value">@(Model.MaintenanceRecords?.Count ?? 0)</span>
                                </p>
                            </div>
                        </div>

                        <hr />

                        @if (latestMaintenance != null)
                        {
                            <h5 class="mb-3">Latest Maintenance</h5>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <p class="mb-2">
                                        <span class="info-label">Date:</span>
                                        <span class="info-value">@latestMaintenance.MaintenanceDate.ToString("MMMM d, yyyy")</span>
                                    </p>
                                    <p class="mb-2">
                                        <span class="info-label">Type:</span>
                                        <span class="info-value">@latestMaintenance.MaintenanceType</span>
                                    </p>
                                </div>
                                <div class="col-md-6">
                                    <p class="mb-2">
                                        <span class="info-label">Technician:</span>
                                        <span class="info-value">@(latestMaintenance.TechnicianName ?? "Not specified")</span>
                                    </p>
                                    <p class="mb-2">
                                        <span class="info-label">Next Due:</span>
                                        <span class="info-value">
                                            @if (latestMaintenance.NextMaintenanceDate.HasValue)
                                            {
                                                @latestMaintenance.NextMaintenanceDate.Value.ToString("MMMM d, yyyy")
                                                var daysRemaining = (latestMaintenance.NextMaintenanceDate.Value - DateTime.Today).Days;
                                                <text>(@daysRemaining @(daysRemaining == 1 ? "day" : "days") remaining)</text>
                                                if (latestMaintenance.NextMaintenanceDate.Value < DateTime.Today)
                                                {
                                                    <span class="badge bg-danger maintenance-badge">OVERDUE</span>
                                                }
                                                else if (latestMaintenance.NextMaintenanceDate.Value < DateTime.Today.AddDays(30))
                                                {
                                                    <span class="badge bg-warning text-dark maintenance-badge">DUE SOON</span>
                                                }
                                            }
                                            else
                                            {
                                                <span>Not specified</span>
                                            }
                                        </span>
                                    </p>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(latestMaintenance.Notes))
                            {
                                <div class="mb-3">
                                    <span class="info-label">Notes:</span>
                                    <div class="info-value p-2 bg-light rounded">@latestMaintenance.Notes</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                No maintenance records found for this AC unit.
                            </div>
                        }

                        <hr />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-3">
                            <a href="@Url.Action("Details", "ACUnits", new { id = Model.Id })" class="btn btn-primary me-md-2">
                                <i class="bi bi-info-circle"></i> Full Details
                            </a>
                            <a href="@Url.Action("Create", "MaintenanceRecords", new { acUnitId = Model.Id })" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Add Maintenance
                            </a>
                        </div>
                    </div>
                    <div class="card-footer text-muted text-center">
                        <small>Last updated: @DateTime.Now.ToString("MMMM d, yyyy h:mm tt")</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>