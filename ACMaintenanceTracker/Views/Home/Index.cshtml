@using static ACMaintenanceTracker.Controllers.HomeController
@using static ACMaintenanceTracker.Controllers.ACUnitsController
@using static ACMaintenanceTracker.Controllers.MaintenanceRecordsController
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AC Maintenance Tracker";
}
@model HomeViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-9ndCyUaIbzAi2FUVXJi0CjmCapSmO7SnpJef0486qhLnuZ2cdeRhO02iuK6FUUVM" crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <!-- Custom CSS -->
    <style>
        body {
            padding-top: 2rem;
            background-color: #f8f9fa;
        }

        .card {
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            margin-bottom: 1.5rem;
        }

        .card-header {
            font-weight: 600;
        }

        .list-group-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .badge {
            font-size: 0.85em;
        }

        .display-4 {
            margin-bottom: 1rem;
            color: #2c3e50;
        }

        .lead {
            color: #7f8c8d;
            margin-bottom: 2rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="text-center">
            <h1 class="display-4">AC Maintenance Tracker</h1>
            <p class="lead">Track and manage all your air conditioning unit maintenance records</p>
        </div>

        <div class="row mt-5">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5>Recent Maintenance</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.RecentMaintenance.Count > 0)
                        {
                            <ul class="list-group">
                                @foreach (var record in Model.RecentMaintenance)
                                {
                                    <li class="list-group-item">
                                        <strong>@record.ACUnit.ACIdentifier</strong> - @record.MaintenanceDate.ToShortDateString()
                                        <span class="badge bg-info float-end">@record.MaintenanceType</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No recent maintenance records found.</p>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-controller="MaintenanceRecords" asp-action="Create" class="btn btn-success">
                            <i class="bi bi-plus-circle"></i> Add New Maintenance
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-warning">
                        <h5>Due for Maintenance</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.DueForMaintenance.Count > 0)
                        {
                            <ul class="list-group">
                                @foreach (var unit in Model.DueForMaintenance)
                                {
                                    var latestMaintenance = unit.MaintenanceRecords
                                    .OrderByDescending(m => m.MaintenanceDate)
                                    .FirstOrDefault();
                                    <li class="list-group-item">
                                        <strong>@unit.ACIdentifier</strong>
                                        @if (latestMaintenance?.NextMaintenanceDate.HasValue == true)
                                        {
                                            var days = (latestMaintenance.NextMaintenanceDate.Value - DateTime.Today).Days;
                                            <span class="float-end @(days < 0 ? "text-danger fw-bold" : "text-warning")">
                                                @if (days < 0)
                                                {
                                                    <i class="bi bi-exclamation-triangle-fill"></i> 
                                                    @($"OVERDUE by {-days} days")
                                                }
                                                else
                                                {
                                                    <i class="bi bi-clock"></i> 
                                                    @($"Due in {days} days")
                                                }
                                            </span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No AC units due for maintenance soon.</p>
                        }
                    </div>
                    <div class="card-footer">
                        <a asp-controller="ACUnits" asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-list-ul"></i> View All AC Units
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="d-grid gap-2">
                    <a asp-controller="ACUnits" asp-action="Create" class="btn btn-lg btn-outline-primary">
                        <i class="bi bi-plus-circle-fill"></i> Add New AC Unit
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" integrity="sha384-geWF76RCwLtnZ8qwWowPQNguL3RmwHVBC9FhGdlKrxdiJJigb/j/68SIy3Te4Bkz" crossorigin="anonymous"></script>

    <!-- Custom JavaScript -->
    <script>
        $(document).ready(function() {
            // Add animation to cards on hover
            $('.card').hover(
                function() {
                    $(this).css('transform', 'translateY(-5px)');
                },
                function() {
                    $(this).css('transform', 'translateY(0)');
                }
            );

            // Add confirmation for important actions
            $('.btn-danger').click(function() {
                return confirm('Are you sure you want to perform this action?');
            });

            // Tooltip initialization
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
</body>
</html>