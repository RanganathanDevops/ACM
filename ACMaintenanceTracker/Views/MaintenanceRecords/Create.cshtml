@model ACMaintenanceTracker.Models.CreateMaintenanceRecord
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Create Maintenance Record";
    var acIdentifier = ViewData["EquipmentIdentifier"] as string;
    var acUnitId = ViewData["EquipmentId"] as int?;
    var equipmentType = ViewData["EquipmentType"];
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary-color: #4361ee;
            --secondary-color: #3f37c9;
            --accent-color: #4895ef;
            --light-color: #f8f9fa;
            --dark-color: #212529;
            --success-color: #4cc9f0;
            --danger-color: #f72585;
            --warning-color: #f8961e;
        }

        body {
            background-color: #f5f7fb;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .form-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            background: white;
        }

        .form-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 1.5rem;
            text-align: center;
        }

            .form-header h1 {
                font-weight: 600;
                margin-bottom: 0.5rem;
                font-size: 1.75rem;
            }

        .form-body {
            padding: 2rem;
        }

        .form-label {
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .form-control, .form-select {
            border-radius: 6px;
            padding: 0.6rem 1rem;
            border: 1px solid #ced4da;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--accent-color);
                box-shadow: 0 0 0 0.25rem rgba(72, 149, 239, 0.25);
            }

        textarea.form-control {
            min-height: 120px;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

            .btn-primary:hover {
                background-color: var(--secondary-color);
                border-color: var(--secondary-color);
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

        .required-field::after {
            content: " *";
            color: var(--danger-color);
        }

        .input-group-text {
            background-color: #f0f2f5;
        }

        .equipment-badge {
            background-color: var(--accent-color);
            color: white;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
        }

            .equipment-badge i {
                margin-right: 0.5rem;
            }

        .maintenance-type-group {
            border-left: 4px solid var(--accent-color);
            padding-left: 1rem;
            margin-bottom: 1.5rem;
        }

        .loading-spinner {
            display: none;
            color: var(--primary-color);
        }
    </style>
</head>
<body>
    <div class="form-container">
        <div class="form-header">
            <h1><i class="fas fa-tools me-2"></i>@ViewData["Title"]</h1>
            <p>
                <span class="equipment-badge">
                    <i class="fas fa-snowflake me-1"></i>@equipmentType: @acIdentifier
                </span>
            </p>
        </div>

        <div class="form-body">
            <form asp-action="Create" id="maintenanceForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <input type="hidden" asp-for="EquipmentId" value="@acUnitId" />
                <input type="hidden" id="equipmentType" value="@equipmentType" />

                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="MaintenanceDate" class="form-label required-field">
                            <i class="fas fa-calendar-alt me-2"></i>Maintenance Date
                        </label>
                        <input asp-for="MaintenanceDate" class="form-control" type="date" required />
                        <span asp-validation-for="MaintenanceDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NextMaintenanceDate" class="form-label">
                            <i class="fas fa-calendar-check me-2"></i>Next Maintenance Date
                        </label>
                        <input asp-for="NextMaintenanceDate" class="form-control" type="date" />
                        <span asp-validation-for="NextMaintenanceDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3 maintenance-type-group">
                    <label asp-for="MaintenanceType" class="form-label required-field">
                        <i class="fas fa-tasks me-2"></i>Maintenance Type
                    </label>
                    <select asp-for="MaintenanceType" class="form-select" required id="maintenanceTypeSelect">
                        <option value="">-- Select Maintenance Type --</option>
                        <!-- Options will be populated by JavaScript based on equipment type -->
                    </select>
                    <span asp-validation-for="MaintenanceType" class="text-danger small"></span>
                    <div class="mt-2">
                        <span class="text-muted small" id="maintenanceTypeDescription"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="TechnicianName" class="form-label">
                        <i class="fas fa-user-tie me-2"></i>Technician Name
                    </label>
                    <input asp-for="TechnicianName" class="form-control" placeholder="Name of technician" />
                    <span asp-validation-for="TechnicianName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PartsReplaced" class="form-label">
                        <i class="fas fa-cog me-2"></i>Parts Replaced
                    </label>
                    <textarea asp-for="PartsReplaced" class="form-control" rows="2" placeholder="List any parts replaced (comma separated)"></textarea>
                    <span asp-validation-for="PartsReplaced" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Cost" class="form-label">
                        <i class="fas fa-dollar-sign me-2"></i>Cost
                    </label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Cost" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Cost" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label">
                        <i class="fas fa-clipboard me-2"></i>Notes
                    </label>
                    <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Detailed notes about the maintenance performed..."></textarea>
                    <span asp-validation-for="Notes" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Details", "Equipment", new { id = acUnitId })" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Back to Equipment
                    </a>
                    <button type="submit" class="btn btn-primary" id="submitButton">
                        <i class="fas fa-save me-2"></i>Create Record
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Maintenance types by equipment category
            const maintenanceTypes = {
                'Transformer': [
                    { value: 'Fuse replacement', description: 'Replacement of blown or faulty fuses' },
                    { value: 'EB reading', description: 'Recording electricity board meter readings' },
                    { value: 'Phase sequence correction', description: 'Correcting phase sequence issues' }
                ],
                'Generator': [
                    { value: 'Diesel refilling', description: 'Refilling diesel fuel tank' },
                    { value: 'Engine oil refilling', description: 'Changing or topping up engine oil' },
                    { value: 'Diesel exhaust fluid (DEF) refilling', description: 'Refilling AdBlue/DEF fluid' },
                    { value: 'Battery replacement status', description: 'Checking or replacing batteries' },
                    { value: 'AMC renewal status', description: 'Annual Maintenance Contract renewal' },
                    { value: 'Generator reading details', description: 'Recording generator operational metrics' }
                ],
                'WaterPlant': [
                    { value: 'Media replacement', description: 'Replacing filtration media' },
                    { value: 'Multiport valve replacement', description: 'Replacing multiport valves' },
                    { value: 'Flowmeter replacement', description: 'Replacing flow measurement devices' },
                    { value: 'Tank cleaning details', description: 'Cleaning and sanitizing water tanks' },
                    { value: 'Motor and starter servicing/replacement details', description: 'Maintenance of motors and starters' }
                ],
                'ROPlant': [
                    { value: 'Media replacement', description: 'Replacing filtration media' },
                    { value: 'Multiport valve replacement', description: 'Replacing multiport valves' },
                    { value: 'Flowmeter replacement', description: 'Replacing flow measurement devices' },
                    { value: 'Membrane replacement', description: 'Replacing RO membranes' },
                    { value: 'Spun filter replacement', description: 'Replacing pre-filters' },
                    { value: 'Tank cleaning details', description: 'Cleaning and sanitizing water tanks' },
                    { value: 'Motor and starter servicing/replacement details', description: 'Maintenance of motors and starters' }
                ],
                'STPlant': [
                    { value: 'Media replacement', description: 'Replacing filtration media' },
                    { value: 'Multiport valve replacement', description: 'Replacing multiport valves' },
                    { value: 'Flowmeter replacement', description: 'Replacing flow measurement devices' },
                    { value: 'Membrane replacement', description: 'Replacing treatment membranes' },
                    { value: 'Sensor replacement', description: 'Replacing monitoring sensors' },
                    { value: 'Solenoid valve replacement', description: 'Replacing solenoid valves' },
                    { value: 'Blower filter replacement', description: 'Replacing air blower filters' },
                    { value: 'Blower oil replacement', description: 'Changing blower lubricant' },
                    { value: 'Motor and starter servicing/replacement details', description: 'Maintenance of motors and starters' }
                ],
                'FireSystem': [
                    { value: 'Hose reel monthly inspection', description: 'Monthly check of hose reels' },
                    { value: 'Motor running status check', description: 'Testing pump motor operation' },
                    { value: 'Motor leakage check', description: 'Checking for motor fluid leaks' },
                    { value: 'Motor and starter servicing/replacement details', description: 'Maintenance of motors and starters' }
                ],
                'ACIndoorUnit': [
                    { value: 'Filter cleaning', description: 'Cleaning or replacing air filters' },
                    { value: 'Coil cleaning', description: 'Cleaning evaporator coils' },
                    { value: 'Expansion valve replacement', description: 'Replacing expansion valves' },
                    { value: 'Drain pump replacement', description: 'Replacing condensate pumps' },
                    { value: 'Sensor replacement', description: 'Replacing temperature/humidity sensors' },
                    { value: 'Display replacement', description: 'Replacing control displays' },
                    { value: 'PCB board replacement', description: 'Replacing circuit boards' }
                ],
                'ACOutdoorUnit': [
                    { value: 'Coil cleaning', description: 'Cleaning condenser coils' },
                    { value: 'Gas refilling', description: 'Recharging refrigerant' },
                    { value: 'Sensor replacement', description: 'Replacing outdoor sensors' },
                    { value: 'Main PCB board replacement', description: 'Replacing main control boards' },
                    { value: 'Compressor replacement', description: 'Replacing compressor units' },
                    { value: 'Inverter PCB board replacement', description: 'Replacing inverter boards' }
                ]
            };

            // Set default date to today
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('MaintenanceDate').value = today;

            // Get equipment type from hidden field
            const equipmentType = document.getElementById('equipmentType').value;
            const selectElement = document.getElementById('maintenanceTypeSelect');
            const descriptionElement = document.getElementById('maintenanceTypeDescription');

            // Populate maintenance types based on equipment type
            if (equipmentType && maintenanceTypes[equipmentType]) {
                maintenanceTypes[equipmentType].forEach(type => {
                    const option = document.createElement('option');
                    option.value = type.value;
                    option.textContent = type.value;
                    selectElement.appendChild(option);
                });
            }

            // Show description when type is selected
            selectElement.addEventListener('change', function() {
                if (this.value && maintenanceTypes[equipmentType]) {
                    const selectedType = maintenanceTypes[equipmentType].find(t => t.value === this.value);
                    descriptionElement.textContent = selectedType ? selectedType.description : '';
                } else {
                    descriptionElement.textContent = '';
                }
            });

            // Form submission handling
            const form = document.getElementById('maintenanceForm');
            if (form) {
                form.addEventListener('submit', function() {
                    const submitButton = document.getElementById('submitButton');
                    if (submitButton) {
                        submitButton.disabled = true;
                        submitButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';
                    }
                });
            }

            // Add animation to form elements on focus
            const formControls = document.querySelectorAll('.form-control, .form-select');
            formControls.forEach(control => {
                control.addEventListener('focus', function() {
                    this.parentElement.classList.add('animate__animated', 'animate__pulse');
                });
                control.addEventListener('blur', function() {
                    this.parentElement.classList.remove('animate__animated', 'animate__pulse');
                });
            });
        });
    </script>
</body>
</html>