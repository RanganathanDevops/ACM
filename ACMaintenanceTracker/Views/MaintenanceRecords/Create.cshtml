@model ACMaintenanceTracker.Models.MaintenanceRecord
@{
    ViewData["Title"] = "Create Maintenance Record";
    var acIdentifier = ViewData["ACIdentifier"] as string;
    var acUnitId = ViewData["ACUnitId"] as int?;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- jQuery UI CSS for datepicker -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/themes/base/jquery-ui.min.css">

    <style>
        :root {
            --primary-color: #3498db;
            --secondary-color: #6c757d;
            --success-color: #28a745;
            --danger-color: #dc3545;
            --light-color: #f8f9fa;
            --dark-color: #343a40;
        }

        body {
            background-color: #f5f7fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .maintenance-form-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 0 15px;
        }

        .maintenance-form {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .form-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e9ecef;
        }

            .form-header h2 {
                color: var(--dark-color);
                font-weight: 600;
                margin-bottom: 0.5rem;
            }

            .form-header h4 {
                color: var(--secondary-color);
                font-weight: 400;
            }

        .form-label {
            font-weight: 500;
            margin-bottom: 0.5rem;
            color: var(--dark-color);
            display: block;
        }

        .form-control {
            padding: 0.5rem 0.75rem;
            border-radius: 0.375rem;
            border: 1px solid #ced4da;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            width: 100%;
        }

            .form-control:focus {
                border-color: var(--primary-color);
                box-shadow: 0 0 0 0.25rem rgba(52, 152, 219, 0.25);
            }

        .btn {
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            font-weight: 500;
            transition: all 0.2s ease-in-out;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .btn i {
                margin-right: 0.5rem;
            }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

            .btn-primary:hover {
                background-color: #2c7cb6;
                border-color: #2a75ad;
            }

        .btn-secondary {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
        }

            .btn-secondary:hover {
                background-color: #5c636a;
                border-color: #565e64;
            }

        .alert-danger {
            color: var(--danger-color);
            background-color: #f8d7da;
            border-color: #f5c6cb;
            padding: 0.75rem 1.25rem;
            margin-bottom: 1rem;
            border: 1px solid transparent;
            border-radius: 0.25rem;
        }

        .text-danger {
            color: var(--danger-color);
        }

        .field-validation-error {
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: block;
        }

        .input-validation-error {
            border-color: var(--danger-color);
        }

            .input-validation-error:focus {
                border-color: var(--danger-color);
                box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
            }

        .ui-datepicker {
            background: white;
            border: 1px solid #ddd;
            border-radius: 0.375rem;
            padding: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
            z-index: 1000 !important;
        }

        .required-field::after {
            content: " *";
            color: var(--danger-color);
        }
    </style>
</head>
<body>
    <div class="maintenance-form-container">
        <div class="maintenance-form">
            <div class="form-header">
                <h2>@ViewData["Title"]</h2>
                <h4><i class="fas fa-snowflake text-primary me-2"></i>AC Unit: @acIdentifier</h4>
            </div>

            <form id="maintenanceForm" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="ACUnitId" value="@acUnitId" />

                <div class="mb-3">
                    <label asp-for="MaintenanceDate" class="form-label required-field">Maintenance Date</label>
                    <input asp-for="MaintenanceDate" class="form-control datepicker" type="text" autocomplete="off" required />
                    <span asp-validation-for="MaintenanceDate" class="text-danger field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MaintenanceType" class="form-label required-field">Maintenance Type</label>
                    <select asp-for="MaintenanceType" class="form-control" required>
                        <option value="">-- Select Maintenance Type --</option>
                        <option value="Routine Check">Routine Check</option>
                        <option value="Filter Replacement">Filter Replacement</option>
                        <option value="Coil Cleaning">Coil Cleaning</option>
                        <option value="Refrigerant Recharge">Refrigerant Recharge</option>
                        <option value="Electrical Repair">Electrical Repair</option>
                        <option value="Mechanical Repair">Mechanical Repair</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="MaintenanceType" class="text-danger field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TechnicianName" class="form-label required-field">Technician Name</label>
                    <input asp-for="TechnicianName" class="form-control" required />
                    <span asp-validation-for="TechnicianName" class="text-danger field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Notes" class="text-danger field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NextMaintenanceDate" class="form-label">Next Maintenance Date</label>
                    <input asp-for="NextMaintenanceDate" class="form-control datepicker" type="text" autocomplete="off" />
                    <span asp-validation-for="NextMaintenanceDate" class="text-danger field-validation-error"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="@Url.Action("Details", "ACUnits", new { id = acUnitId })" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Unit
                    </a>
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="fas fa-save"></i> Create Record
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- jQuery UI -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.13.2/jquery-ui.min.js"></script>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function() {
            // Initialize datepicker for all elements with class 'datepicker'
            $(".datepicker").datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true,
                showButtonPanel: true,
                beforeShow: function(input, inst) {
                    inst.dpDiv.css({
                        marginTop: -input.offsetHeight + "px",
                        marginLeft: input.offsetWidth + "px"
                    });
                }
            });

            // Set today's date as default for MaintenanceDate
            var today = new Date();
            $("#MaintenanceDate").datepicker("setDate", today);

            // Form submission handler
            $("#maintenanceForm").on("submit", function(e) {
                e.preventDefault();

                // Disable submit button to prevent double submission
                $("#submitBtn").prop("disabled", true).html('<i class="fas fa-spinner fa-spin"></i> Processing...');

                // Clear previous errors
                $(".field-validation-error").text("");
                $(".form-control").removeClass("is-invalid");

                // Client-side validation
                let isValid = true;
                const today = new Date();
                today.setHours(0, 0, 0, 0);

                // Validate required fields
                if (!$("#MaintenanceType").val()) {
                    $("#MaintenanceType").addClass("is-invalid");
                    $("#MaintenanceType").next(".field-validation-error").text("Please select a maintenance type");
                    isValid = false;
                }

                if (!$("#TechnicianName").val()) {
                    $("#TechnicianName").addClass("is-invalid");
                    $("#TechnicianName").next(".field-validation-error").text("Technician name is required");
                    isValid = false;
                }

                // Validate MaintenanceDate
                const maintenanceDate = $("#MaintenanceDate").datepicker("getDate");
                if (!maintenanceDate) {
                    $("#MaintenanceDate").addClass("is-invalid");
                    $("#MaintenanceDate").next(".field-validation-error").text("Maintenance date is required");
                    isValid = false;
                } else if (maintenanceDate > today) {
                    $("#MaintenanceDate").addClass("is-invalid");
                    $("#MaintenanceDate").next(".field-validation-error").text("Date cannot be in the future");
                    isValid = false;
                }

                // Validate NextMaintenanceDate if provided
                const nextMaintenanceDate = $("#NextMaintenanceDate").datepicker("getDate");
                if (nextMaintenanceDate && maintenanceDate && nextMaintenanceDate <= maintenanceDate) {
                    $("#NextMaintenanceDate").addClass("is-invalid");
                    $("#NextMaintenanceDate").next(".field-validation-error").text("Must be after maintenance date");
                    isValid = false;
                }

                if (!isValid) {
                    $("#submitBtn").prop("disabled", false).html('<i class="fas fa-save"></i> Create Record');
                    return;
                }

                // Submit form via AJAX
                $.ajax({
                    url: $(this).attr("action"),
                    type: "POST",
                    data: $(this).serialize(),
                    headers: {
                        "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function(response) {
                        if (response.success && response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        } else if (response.errors) {
                            // Display server-side validation errors
                            $.each(response.errors, function(key, value) {
                                if (value && value.length > 0) {
                                    const $field = $("#" + key);
                                    $field.addClass("is-invalid");
                                    $field.next(".field-validation-error").text(value[0]);
                                }
                            });
                        }
                    },
                    error: function(xhr) {
                        if (xhr.status === 400 && xhr.responseJSON && xhr.responseJSON.errors) {
                            // Display validation errors
                            $.each(xhr.responseJSON.errors, function(key, value) {
                                if (value && value.length > 0) {
                                    const $field = $("#" + key);
                                    $field.addClass("is-invalid");
                                    $field.next(".field-validation-error").text(value[0]);
                                }
                            });
                        } else {
                            alert("An error occurred while saving the record. Please try again.");
                        }
                    },
                    complete: function() {
                        $("#submitBtn").prop("disabled", false).html('<i class="fas fa-save"></i> Create Record');
                    }
                });
            });
        });
    </script>
</body>
</html>