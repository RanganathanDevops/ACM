@using ACMaintenanceTracker.Models
@using static ACMaintenanceTracker.Controllers.HomeController
@using static ACMaintenanceTracker.Controllers.ACUnitsController
@using static ACMaintenanceTracker.Controllers.MaintenanceRecordsController
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AC Unit Details";
}
@model ACUnit
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --primary-color: #3498db;
            --secondary-color: #6c757d;
            --warning-color: #ffc107;
            --info-color: #17a2b8;
        }

        body {
            background-color: #f8f9fa;
            padding-top: 20px;
        }

        .details-card {
            border: none;
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
            margin-bottom: 2rem;
            overflow: hidden;
        }

        .card-header {
            background-color: var(--primary-color);
            color: white;
            padding: 1.25rem 1.5rem;
            border-bottom: none;
        }

            .card-header h4 {
                margin-bottom: 0;
                font-weight: 600;
            }

        .card-body {
            padding: 2rem;
        }

        .card-footer {
            background-color: rgba(0, 0, 0, 0.03);
            border-top: 1px solid rgba(0, 0, 0, 0.05);
            padding: 1.25rem 1.5rem;
            display: flex;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        dl.row {
            margin-bottom: 2rem;
        }

        dt.col-sm-3 {
            font-weight: 600;
            color: #495057;
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #f1f1f1;
        }

        dd.col-sm-9 {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #f1f1f1;
        }

        .maintenance-title {
            color: var(--primary-color);
            font-weight: 600;
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid #eee;
        }

        .table {
            margin-top: 1.5rem;
            border: 1px solid #dee2e6;
        }

            .table thead th {
                background-color: #f8f9fa;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.5px;
                border-bottom-width: 2px;
            }

            .table tbody tr:hover {
                background-color: rgba(0, 0, 0, 0.02);
            }

        .alert-info {
            background-color: #e7f8ff;
            border-color: #b8ecff;
            color: #0c5460;
        }

        .btn {
            font-weight: 500;
            padding: 0.5rem 1rem;
            border-radius: 0.375rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-warning {
            background-color: var(--warning-color);
            border-color: var(--warning-color);
            color: #212529;
        }

        .btn-secondary {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
        }

        .btn-info {
            background-color: var(--info-color);
            border-color: var(--info-color);
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .card-body {
                padding: 1.5rem;
            }

            .card-footer {
                flex-direction: column;
                gap: 0.5rem;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            dl.row dt.col-sm-3,
            dl.row dd.col-sm-9 {
                padding: 0.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="details-card">
            <div class="card-header">
                <h4>
                    <i class="fas fa-snowflake me-2"></i>AC Unit Details - @Model.ACIdentifier
                </h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">
                        <i class="fas fa-id-card text-muted me-2"></i>AC Identifier
                    </dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.ACIdentifier)</dd>

                    <dt class="col-sm-3">
                        <i class="fas fa-layer-group text-muted me-2"></i>Floor Number
                    </dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.FloorNumber)</dd>

                    <dt class="col-sm-3">
                        <i class="fas fa-door-open text-muted me-2"></i>Room Number
                    </dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.RoomNumber)</dd>

                    <dt class="col-sm-3">
                        <i class="fas fa-tag text-muted me-2"></i>Model
                    </dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Model)</dd>

                    <dt class="col-sm-3">
                        <i class="fas fa-calendar-alt text-muted me-2"></i>Installation Date
                    </dt>
                    <dd class="col-sm-9">@Model.InstallationDate.ToString()</dd>
                </dl>

                <h5 class="maintenance-title">
                    <i class="fas fa-tools me-2"></i>Maintenance Records
                </h5>
                @if (Model.MaintenanceRecords != null && Model.MaintenanceRecords.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Technician</th>
                                    <th>Service Type</th>
                                    <th>Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in Model.MaintenanceRecords)
                                {
                                    <tr>
                                        <td>@record.MaintenanceDate.ToString("d")</td>
                                        <td>@record.TechnicianName</td>
                                        <td>@record.MaintenanceType</td>
                                        <td>@record.Notes</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>No maintenance records found for this unit.
                    </div>
                }
            </div>
            <div class="card-footer">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="fas fa-edit me-1"></i>Edit
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Back to List
                </a>
                <a asp-action="GenerateQRCode" asp-route-id="@Model.Id" class="btn btn-info">
                    <i class="fas fa-qrcode me-1"></i>Generate QR Code
                </a>
            </div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function() {
            // Add hover effects to table rows
            $('.table tbody tr').hover(
                function() {
                    $(this).css('transform', 'translateX(5px)');
                    $(this).css('transition', 'transform 0.2s ease');
                },
                function() {
                    $(this).css('transform', 'translateX(0)');
                }
            );

            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();

            // Format dates in the maintenance records table
            $('.maintenance-date').each(function() {
                const dateText = $(this).text().trim();
                if (dateText) {
                    const date = new Date(dateText);
                    if (!isNaN(date)) {
                        $(this).text(date.toLocaleDateString());
                    }
                }
            });

            // Button loading states
            $('.btn').on('click', function() {
                const btn = $(this);
                if (!btn.hasClass('disabled')) {
                    btn.addClass('disabled');
                    btn.find('i').remove();
                    btn.prepend('<i class="fas fa-spinner fa-spin me-1"></i>');
                    setTimeout(function() {
                        btn.removeClass('disabled');
                        const iconClass = btn.hasClass('btn-warning') ? 'fa-edit' :
                                          btn.hasClass('btn-secondary') ? 'fa-arrow-left' : 'fa-qrcode';
                        btn.find('i').remove();
                        btn.prepend('<i class="fas ' + iconClass + ' me-1"></i>');
                    }, 2000);
                }
            });
        });
    </script>
</body>
</html>