@using ACMaintenanceTracker.Models
@using static ACMaintenanceTracker.Controllers.HomeController
@using static ACMaintenanceTracker.Controllers.ACUnitsController
@using static ACMaintenanceTracker.Controllers.MaintenanceRecordsController
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AC Unit Details";
}
@model ACUnit
<div class="card">
    <div class="card-header bg-primary text-white">
        <h4>AC Unit Details - @Model.ACIdentifier</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">AC Identifier:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ACIdentifier)</dd>

            <dt class="col-sm-3">Floor Number:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FloorNumber)</dd>

            <dt class="col-sm-3">Room Number:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RoomNumber)</dd>

            <dt class="col-sm-3">Model:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Model)</dd>

            <dt class="col-sm-3">Installation Date:</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.InstallationDate)</dd>
        </dl>

        <h5 class="mt-4">Maintenance Records</h5>
        @if (Model.MaintenanceRecords != null && Model.MaintenanceRecords.Any())
        {
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Technician</th>
                        <th>Service Type</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.MaintenanceRecords)
                    {
                        <tr>
                            <td>@record.MaintenanceDate.ToString()</td>
                            <td>@record.TechnicianName</td>
                            <td>@record.MaintenanceType</td>
                            <td>@record.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No maintenance records found for this unit.</div>
        }
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        <a asp-action="GenerateQRCode" asp-route-id="@Model.Id" class="btn btn-info">Generate QR Code</a>
    </div>
</div>

@section Styles {
    <style>
        .card {
            margin-top: 20px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .card-header {
            padding: 15px 20px;
        }

        dt {
            font-weight: 600;
        }
    </style>
}