@model IEnumerable<ACMaintenanceTracker.Models.ACUnit>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AC Units Management";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">
            <i class="fas fa-snowflake text-primary me-2"></i>AC Units
        </h1>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus me-2"></i>Add New Unit
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white border-bottom">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-table text-muted me-2"></i>Units List
                </h5>
                <div class="d-flex">
                    <div class="input-group input-group-sm" style="width: 200px;">
                        <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                        <input type="text" id="customSearch" class="form-control form-control-sm" placeholder="Search...">
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="acUnitsTable" class="table table-hover mb-0" style="width:100%">
                    <thead class="bg-light">
                        <tr>
                            <th>Unit ID</th>
                            <th>Floor</th>
                            <th>Room</th>
                            <th>Model</th>
                            <th>Installed</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">@item.ACIdentifier</td>
                                <td class="align-middle">@item.FloorNumber</td>
                                <td class="align-middle">@item.RoomNumber</td>
                                <td class="align-middle">@item.Model</td>
                                <td class="align-middle">@item.InstallationDate.ToString()</td>
                                <td class="align-middle">
                                    <div class="d-inline-flex">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info mx-1" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning mx-1" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger mx-1" title="Delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                        <a asp-action="GenerateQRCode" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary mx-1" title="QR Code">
                                            <i class="fas fa-qrcode"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            border: none;
            border-radius: 0.5rem;
            overflow: hidden;
        }

        .card-header {
            padding: 1rem 1.25rem;
            background-color: white;
        }

        .table {
            margin-bottom: 0;
        }

            .table th {
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.5px;
                padding: 0.75rem 1rem;
                white-space: nowrap;
            }

            .table td {
                padding: 0.75rem 1rem;
                vertical-align: middle;
                white-space: nowrap;
            }

        .table-hover tbody tr:hover {
            background-color: rgba(0, 0, 0, 0.02);
        }

        .btn-sm {
            padding: 0.25rem 0.5rem;
            font-size: 0.75rem;
            line-height: 1.5;
            border-radius: 0.25rem;
            min-width: 30px;
        }

        .btn-outline-info {
            color: #0dcaf0;
            border-color: #0dcaf0;
        }

            .btn-outline-info:hover {
                background-color: #0dcaf0;
                color: white;
            }

        .btn-outline-warning {
            color: #ffc107;
            border-color: #ffc107;
        }

            .btn-outline-warning:hover {
                background-color: #ffc107;
                color: #212529;
            }

        .btn-outline-danger {
            color: #dc3545;
            border-color: #dc3545;
        }

            .btn-outline-danger:hover {
                background-color: #dc3545;
                color: white;
            }

        .btn-outline-secondary {
            color: #6c757d;
            border-color: #6c757d;
        }

            .btn-outline-secondary:hover {
                background-color: #6c757d;
                color: white;
            }

        .dataTables_wrapper .dataTables_filter {
            display: none;
        }

        #customSearch {
            border-left: none;
        }

            #customSearch:focus {
                box-shadow: none;
                border-color: #ced4da;
            }

        .input-group-text {
            background-color: white;
            border-right: none;
        }
    </style>
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            var table = $('#acUnitsTable').DataTable({
                responsive: true,
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "No entries available",
                    infoFiltered: "(filtered from _MAX_ total entries)",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Prev"
                    }
                },
                columnDefs: [
                    { orderable: false, targets: -1 }
                ],
                initComplete: function () {
                    $('.dataTables_length select').addClass('form-select form-select-sm');
                }
            });

            // Custom search box functionality
            $('#customSearch').keyup(function () {
                table.search($(this).val()).draw();
            });

            // Initialize tooltips
            $('[title]').tooltip({
                placement: 'top',
                trigger: 'hover'
            });
        });
    </script>
}