@using ACMaintenanceTracker.Models
@using static ACMaintenanceTracker.Controllers.HomeController
@using static ACMaintenanceTracker.Controllers.ACUnitsController
@using static ACMaintenanceTracker.Controllers.MaintenanceRecordsController
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AC Unit Details";
}
@model ACUnit

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4>AC Unit Information</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Identifier:</dt>
                        <dd class="col-sm-8">@Model.ACIdentifier</dd>

                        <dt class="col-sm-4">Location:</dt>
                        <dd class="col-sm-8">Floor @Model.FloorNumber, Room @Model.RoomNumber</dd>

                        <dt class="col-sm-4">Model:</dt>
                        <dd class="col-sm-8">@Model.Model</dd>

                        <dt class="col-sm-4">Installed:</dt>
                        <dd class="col-sm-8">@Model.InstallationDate.ToString()</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4>Maintenance History</h4>
                </div>
                <div class="card-body">
                    @if (Model.MaintenanceRecords != null && Model.MaintenanceRecords.Any())
                    {
                        <div class="list-group">
                            @foreach (var record in Model.MaintenanceRecords.OrderByDescending(r => r.MaintenanceDate))
                            {
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1">@record.MaintenanceType</h6>
                                        <small>@record.MaintenanceDate.ToShortDateString()</small>
                                    </div>
                                    <p class="mb-1">@record.Notes</p>
                                    <small>Technician: @record.TechnicianName</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">No maintenance records found.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            margin-bottom: 20px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .list-group-item {
            margin-bottom: 10px;
            border-radius: 4px;
        }
    </style>
}