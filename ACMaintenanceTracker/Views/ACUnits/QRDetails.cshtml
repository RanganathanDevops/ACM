@using ACMaintenanceTracker.Models
@using static ACMaintenanceTracker.Controllers.HomeController
@using static ACMaintenanceTracker.Controllers.ACUnitsController
@using static ACMaintenanceTracker.Controllers.MaintenanceRecordsController
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "AC Unit Details";
    Layout = "_Layout"; // Ensure this matches your layout file
}
@model ACUnit

<!-- First include Font Awesome in head -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<div class="container mt-4 ac-unit-details">
    <div class="row">
        <div class="col-md-6">
            <div class="card unit-card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">AC Unit Information</h4>
                </div>
                <div class="card-body">
                    <dl class="row unit-details">
                        <dt class="col-sm-4">Identifier:</dt>
                        <dd class="col-sm-8">@Model.ACIdentifier</dd>

                        <dt class="col-sm-4">Location:</dt>
                        <dd class="col-sm-8">Floor @Model.FloorNumber, Room @Model.RoomNumber</dd>

                        <dt class="col-sm-4">Model:</dt>
                        <dd class="col-sm-8">@Model.Model</dd>

                        <dt class="col-sm-4">Installed:</dt>
                        <dd class="col-sm-8">@Model.InstallationDate</dd>

                        <dt class="col-sm-4">Status:</dt>
                        <dd class="col-sm-8">
                            <span class="badge status-badge bg-success">Operational</span>
                        </dd>
                    </dl>
                    <div class="unit-actions mt-3">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary me-2">
                            <i class="fas fa-edit me-1"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-trash-alt me-1"></i>Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card maintenance-card">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">Maintenance History</h4>
                        <a asp-controller="MaintenanceRecords" asp-action="Create" asp-route-acUnitId="@Model.Id"
                           class="btn btn-sm btn-light">
                            <i class="fas fa-plus me-1"></i>Add Record
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.MaintenanceRecords != null && Model.MaintenanceRecords.Any())
                    {
                        <div class="maintenance-list list-group">
                            @foreach (var record in Model.MaintenanceRecords.OrderByDescending(r => r.MaintenanceDate))
                            {
                                <div class="list-group-item maintenance-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h6 class="mb-1 maintenance-type">
                                            <i class="fas fa-tools me-2"></i>@record.MaintenanceType
                                        </h6>
                                        <small class="text-muted maintenance-date">@record.MaintenanceDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    <p class="mb-1 maintenance-notes">@record.Notes</p>
                                    <small class="text-muted technician">
                                        <i class="fas fa-user me-1"></i>Technician: @record.TechnicianName
                                    </small>
                                    <div class="mt-2 record-actions">
                                        <a asp-controller="MaintenanceRecords" asp-action="Edit" asp-route-id="@record.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-pencil-alt me-1"></i>Edit
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info no-records">
                            <i class="fas fa-info-circle me-2"></i>No maintenance records found.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Core Styles */
    .ac-unit-details {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Card Styles */
    .unit-card, .maintenance-card {
        border: none;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        margin-bottom: 20px;
    }

    .card-header {
        background-color: #4e73df !important;
        border-radius: 8px 8px 0 0 !important;
        padding: 15px 20px;
    }

        .card-header h4 {
            font-weight: 600;
            margin: 0;
        }

    /* Unit Details Styles */
    .unit-details dt {
        font-weight: 600;
        color: #6c757d;
    }

    .unit-details dd {
        color: #212529;
        margin-bottom: 8px;
    }

    /* Status Badge */
    .status-badge {
        font-size: 12px;
        padding: 5px 10px;
        border-radius: 20px;
    }

    /* Maintenance List Styles */
    .maintenance-list {
        max-height: 400px;
        overflow-y: auto;
    }

    .maintenance-item {
        border-left: 4px solid #4e73df;
        margin-bottom: 10px;
        border-radius: 6px;
        transition: all 0.3s ease;
    }

        .maintenance-item:hover {
            background-color: #f8f9fa;
            transform: translateX(5px);
        }

    .maintenance-type {
        color: #4e73df;
        font-weight: 600;
    }

    .maintenance-notes {
        color: #495057;
    }

    /* Button Styles */
    .btn-sm {
        padding: 5px 10px;
        font-size: 12px;
    }

    .btn-outline-primary {
        border-color: #4e73df;
        color: #4e73df;
    }

        .btn-outline-primary:hover {
            background-color: #4e73df;
            color: white;
        }

    /* Responsive Adjustments */
    @@media (max-width: 768px) {
        .ac-unit-details .row > div {
            margin-bottom: 20px;
        }

        .card-body {
            padding: 15px;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Simple animation for cards
            const cards = document.querySelectorAll('.card');
            cards.forEach((card, index) => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'all 0.5s ease';

                setTimeout(() => {
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                }, 100 * index);
            });

            // Delete confirmation
            document.querySelectorAll('.btn-outline-danger').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    if (!confirm('Are you sure you want to delete this?')) {
                        e.preventDefault();
                    }
                });
            });
        });
    </script>
}