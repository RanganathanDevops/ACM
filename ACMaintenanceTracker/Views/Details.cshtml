@model ACMaintenanceTracker.Models.ACUnit

@{
    ViewData["Title"] = "AC Unit Details";
}

<h1>AC Unit Details</h1>

<div>
    <h4>@Model.ACIdentifier</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ACIdentifier)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ACIdentifier)
        </dd>
        <dt class="col-sm-2">
            Location
        </dt>
        <dd class="col-sm-10">
            Floor @Html.DisplayFor(model => model.FloorNumber), Room @Html.DisplayFor(model => model.RoomNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Model)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Model)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.InstallationDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.InstallationDate)
        </dd>
    </dl>
</div>

<div class="mb-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    <a asp-action="GenerateQRCode" asp-route-id="@Model.Id" class="btn btn-secondary">Generate QR Code</a>
    <a asp-action="Index" class="btn btn-primary">Back to List</a>
</div>

<h4>Maintenance Records</h4>

<p>
    <a asp-controller="MaintenanceRecords" asp-action="Create" asp-route-acUnitId="@Model.Id" class="btn btn-success">Add Maintenance Record</a>
</p>

@if (Model.MaintenanceRecords != null && Model.MaintenanceRecords.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Date</th>
                <th>Type</th>
                <th>Technician</th>
                <th>Next Maintenance</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model.MaintenanceRecords.OrderByDescending(r => r.MaintenanceDate))
            {
                <tr>
                    <td>@record.MaintenanceDate.ToShortDateString()</td>
                    <td>@record.MaintenanceType</td>
                    <td>@record.TechnicianName</td>
                    <td>@(record.NextMaintenanceDate?.ToShortDateString() ?? "N/A")</td>
                    <td>
                        <a asp-controller="MaintenanceRecords" asp-action="Edit" asp-route-id="@record.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-controller="MaintenanceRecords" asp-action="Delete" asp-route-id="@record.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No maintenance records found for this AC unit.</p>
}