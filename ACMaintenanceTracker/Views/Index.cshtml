@model IEnumerable<ACMaintenanceTracker.Models.ACUnit>

@{
    ViewData["Title"] = "AC Units";
}

<h1>AC Units</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>AC Identifier</th>
            <th>Location</th>
            <th>Model</th>
            <th>Maintenance Count</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ACIdentifier)
                </td>
                <td>
                    Floor @Html.DisplayFor(modelItem => item.FloorNumber), Room @Html.DisplayFor(modelItem => item.RoomNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Model)
                </td>
                <td>
                    @item.MaintenanceRecords?.Count
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-action="GenerateQRCode" asp-route-id="@item.Id" class="btn btn-secondary btn-sm">QR Code</a>
                    <a asp-controller="MaintenanceRecords" asp-action="Create" asp-route-acUnitId="@item.Id" class="btn btn-success btn-sm">Add Maintenance</a>
                </td>
            </tr>
        }
    </tbody>
</table>