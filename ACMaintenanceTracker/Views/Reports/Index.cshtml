@using ACMaintenanceTracker.Models
@model ReportsViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Maintenance Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --primary-color: #4361ee;
            --secondary-color: #3f37c9;
            --accent-color: #4895ef;
            --light-color: #f8f9fa;
            --dark-color: #212529;
            --success-color: #4cc9f0;
            --danger-color: #f72585;
            --warning-color: #ffc107;
            --info-color: #17a2b8;
        }

        .report-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 2rem 0;
            margin-bottom: 2rem;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 4px 20px rgba(67, 97, 238, 0.15);
        }

        .report-card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
            margin-bottom: 1.5rem;
            background: white;
        }

            .report-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
            }

        .report-card-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            background-color: white;
        }

        .report-card-body {
            padding: 1.5rem;
        }

        .chart-container {
            position: relative;
            height: 300px;
            width: 100%;
        }

        .filter-card {
            background-color: #f8f9fa;
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
        }

        .stat-badge {
            font-size: 1rem;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            font-weight: 600;
        }

        .total-cost-badge {
            background-color: var(--success-color);
            color: white;
        }

        .avg-cost-badge {
            background-color: var(--info-color);
            color: white;
        }

        .maintenance-count-badge {
            background-color: var(--primary-color);
            color: white;
        }

        .table-responsive {
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        .table thead th {
            background-color: var(--primary-color);
            color: white;
            border-bottom: none;
        }

        .table tbody tr:hover {
            background-color: rgba(67, 97, 238, 0.05);
        }

        .badge-preventive {
            background-color: var(--success-color);
            color: white;
        }

        .badge-corrective {
            background-color: var(--warning-color);
            color: #212529;
        }

        .badge-emergency {
            background-color: var(--danger-color);
            color: white;
        }

        .action-btn {
            border-radius: 8px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            .action-btn i {
                margin-right: 0.5rem;
            }

            .action-btn:hover {
                transform: translateY(-2px);
            }

        @@media (max-width: 768px) {
            .report-header {
                padding: 1.5rem 0;
                border-radius: 0;
            }

            .chart-container {
                height: 250px;
            }
        }
    </style>
</head>
<body>
    <div class="report-header animate__animated animate__fadeIn">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-4 mb-3">
                        <i class="fas fa-chart-bar me-3"></i>Maintenance Reports
                    </h1>
                    <p class="lead mb-0">
                        Analyze maintenance performance and costs
                    </p>
                </div>
                <div class="col-md-4 text-md-end">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-light btn-lg action-btn">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="container">
        <!-- Filters -->
        <div class="filter-card animate__animated animate__fadeIn">
            <form asp-action="GenerateReport" method="post">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Start Date</label>
                        <input type="date" class="form-control" asp-for="StartDate" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">End Date</label>
                        <input type="date" class="form-control" asp-for="EndDate" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Equipment Type</label>
                        <select class="form-select" asp-for="SelectedEquipmentType">
                            <option value="">All Types</option>
                            @foreach (var type in Model.EquipmentTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary action-btn w-100">
                            <i class="fas fa-filter"></i> Apply Filters
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Summary Stats -->
        <div class="row mb-4 animate__animated animate__fadeIn animate-delay-1">
            <div class="col-md-4">
                <div class="report-card h-100">
                    <div class="report-card-body text-center">
                        <i class="fas fa-money-bill-wave fa-3x mb-3" style="color: var(--success-color)"></i>
                        <h5 class="mb-3">Total Maintenance Cost</h5>
                        <span class="stat-badge total-cost-badge">
                            @Model.MaintenanceRecords.Sum(r => r.Cost)
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="report-card h-100">
                    <div class="report-card-body text-center">
                        <i class="fas fa-calculator fa-3x mb-3" style="color: var(--info-color)"></i>
                        <h5 class="mb-3">Average Cost per Maintenance</h5>
                        <span class="stat-badge avg-cost-badge">
                            @(Model.MaintenanceRecords.Count > 0 ?
                                                        Model.MaintenanceRecords.Average(r => r.Cost) : "$0.00")
                        </span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="report-card h-100">
                    <div class="report-card-body text-center">
                        <i class="fas fa-tasks fa-3x mb-3" style="color: var(--primary-color)"></i>
                        <h5 class="mb-3">Total Maintenance Count</h5>
                        <span class="stat-badge maintenance-count-badge">
                            @Model.MaintenanceRecords.Count
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Row -->
        <div class="row mb-4 animate__animated animate__fadeIn animate-delay-2">
            <div class="col-md-6">
                <div class="report-card h-100">
                    <div class="report-card-header">
                        <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Maintenance by Type</h5>
                    </div>
                    <div class="report-card-body">
                        <div class="chart-container">
                            <canvas id="maintenanceTypeChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="report-card h-100">
                    <div class="report-card-header">
                        <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Cost by Equipment Type</h5>
                    </div>
                    <div class="report-card-body">
                        <div class="chart-container">
                            <canvas id="costByEquipmentChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Maintenance Records Table -->
        <div class="row animate__animated animate__fadeIn animate-delay-3">
            <div class="col-12">
                <div class="report-card">
                    <div class="report-card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="fas fa-table me-2"></i>Maintenance Records</h5>
                        <a asp-controller="MaintenanceRecords" asp-action="Create" class="btn btn-success btn-sm action-btn">
                            <i class="fas fa-plus"></i> Add Record
                        </a>
                    </div>
                    <div class="report-card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Equipment</th>
                                        <th>Type</th>
                                        <th>Maintenance Type</th>
                                        <th>Date</th>
                                        <th>Next Due</th>
                                        <th>Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in Model.MaintenanceRecords)
                                    {
                                        <tr>
                                            <td>@record.Equipment.EquipmentIdentifier</td>
                                            <td>@record.Equipment.EquipmentType</td>
                                            <td>
                                                <span class="badge @($"badge-{record.MaintenanceType.ToLower()}")">
                                                    @record.MaintenanceType
                                                </span>
                                            </td>
                                            <td>@record.MaintenanceDate.ToString("d")</td>
                                            <td>@(record.NextMaintenanceDate?.ToString("d") ?? "N/A")</td>
                                            <td>@record.Cost</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function() {
            // Maintenance Type Pie Chart
            var maintenanceTypeCtx = document.getElementById('maintenanceTypeChart').getContext('2d');
            var maintenanceTypeChart = new Chart(maintenanceTypeCtx, {
                type: 'pie',
                data: {
                    labels: ['Preventive', 'Corrective', 'Emergency'],
                    datasets: [{
                        data: [
                            @Model.MaintenanceRecords.Count(r => r.MaintenanceType == "Preventive"),
                            @Model.MaintenanceRecords.Count(r => r.MaintenanceType == "Corrective"),
                            @Model.MaintenanceRecords.Count(r => r.MaintenanceType == "Emergency")
                        ],
                        backgroundColor: [
                            'rgba(76, 201, 240, 0.7)',
                            'rgba(255, 193, 7, 0.7)',
                            'rgba(247, 37, 133, 0.7)'
                        ],
                        borderColor: [
                            'rgba(76, 201, 240, 1)',
                            'rgba(255, 193, 7, 1)',
                            'rgba(247, 37, 133, 1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    var label = context.label || '';
                                    var value = context.raw || 0;
                                    var total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    var percentage = Math.round((value / total) * 100);
                                    return `${label}: ${value} (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });

            // Cost by Equipment Type Bar Chart
            var costByEquipmentCtx = document.getElementById('costByEquipmentChart').getContext('2d');
            var costByEquipmentChart = new Chart(costByEquipmentCtx, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(Model.EquipmentTypes.Select(e => e.ToString()))),
                    datasets: [{
                        label: 'Total Cost',
                        data: @Html.Raw(Json.Serialize(Model.EquipmentTypes.Select(e =>
                                                                                                                Model.MaintenanceRecords
                                                                                                                                .Where(r => r.Equipment.EquipmentType == e)
                                                                                                                                .Sum(r => r.Cost)))),
                        backgroundColor: 'rgba(67, 97, 238, 0.7)',
                        borderColor: 'rgba(67, 97, 238, 1)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return '$' + value;
                                }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return '$' + context.raw.toFixed(2);
                                }
                            }
                        }
                    }
                }
            });

            // Add animation to cards on hover
            $('.report-card').hover(
                function() {
                    $(this).css('transform', 'translateY(-5px)');
                },
                function() {
                    $(this).css('transform', 'translateY(0)');
                }
            );

            // Initialize tooltips
            $('[data-bs-toggle="tooltip"]').tooltip();
        });
    </script>
</body>
</html>