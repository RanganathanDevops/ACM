@using ACMaintenanceTracker.Models
@model IEnumerable<ACMaintenanceTracker.Models.Equipment>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Equipment Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">
    <style>
        :root {
            --primary-color: #4361ee;
            --secondary-color: #3f37c9;
            --accent-color: #4895ef;
            --light-color: #f8f9fa;
            --dark-color: #212529;
            --success-color: #4cc9f0;
            --danger-color: #f72585;
            --warning-color: #f8961e;
            --info-color: #560bad;
        }

        body {
            background-color: #f5f7fb;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .management-container {
            max-width: 1400px;
            margin: 2rem auto;
            padding: 0 1rem;
        }

        .management-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .card {
            border: none;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .card-header {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            color: white;
            padding: 1.25rem 1.5rem;
            border-bottom: none;
        }

        .table-container {
            padding: 0;
        }

        .table {
            margin-bottom: 0;
            font-size: 0.875rem;
        }

            .table th {
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.75rem;
                letter-spacing: 0.5px;
                padding: 1rem;
                white-space: nowrap;
                background-color: #f8f9fa;
                border-bottom: 2px solid #e9ecef;
            }

            .table td {
                padding: 1rem;
                vertical-align: middle;
                border-top: 1px solid #f1f1f1;
            }

        .table-hover tbody tr:hover {
            background-color: rgba(67, 97, 238, 0.03);
        }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            padding: 0.5rem 1.25rem;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: var(--secondary-color);
                border-color: var(--secondary-color);
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

        .action-btn {
            width: 32px;
            height: 32px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            transition: all 0.3s ease;
            margin: 0 3px;
        }

            .action-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

        .btn-details {
            background-color: rgba(72, 149, 239, 0.1);
            color: var(--accent-color);
            border: 1px solid var(--accent-color);
        }

            .btn-details:hover {
                background-color: var(--accent-color);
                color: white;
            }

        .btn-edit {
            background-color: rgba(248, 150, 30, 0.1);
            color: var(--warning-color);
            border: 1px solid var(--warning-color);
        }

            .btn-edit:hover {
                background-color: var(--warning-color);
                color: var(--dark-color);
            }

        .btn-delete {
            background-color: rgba(247, 37, 133, 0.1);
            color: var(--danger-color);
            border: 1px solid var(--danger-color);
        }

            .btn-delete:hover {
                background-color: var(--danger-color);
                color: white;
            }

        .btn-qr {
            background-color: rgba(86, 11, 173, 0.1);
            color: var(--info-color);
            border: 1px solid var(--info-color);
        }

            .btn-qr:hover {
                background-color: var(--info-color);
                color: white;
            }

        .btn-maintenance {
            background-color: rgba(76, 201, 240, 0.1);
            color: var(--success-color);
            border: 1px solid var(--success-color);
        }

            .btn-maintenance:hover {
                background-color: var(--success-color);
                color: white;
            }

        .search-container {
            max-width: 300px;
        }

        .search-input {
            border-left: none;
            font-size: 0.875rem;
            border-radius: 0 8px 8px 0;
        }

            .search-input:focus {
                box-shadow: none;
                border-color: #ced4da;
            }

        .search-icon {
            background-color: white;
            border-right: none;
            border-radius: 8px 0 0 8px;
        }

        .status-badge {
            padding: 0.25rem 0.5rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-active {
            background-color: rgba(76, 201, 240, 0.1);
            color: var(--success-color);
        }

        .badge-inactive {
            background-color: rgba(108, 117, 125, 0.1);
            color: var(--secondary-color);
        }

        .badge-warning {
            background-color: rgba(248, 150, 30, 0.1);
            color: var(--warning-color);
        }

        .equipment-icon {
            width: 24px;
            height: 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 8px;
            color: var(--primary-color);
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border-radius: 8px !important;
            margin: 0 3px;
            border: 1px solid transparent !important;
            transition: all 0.3s ease;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
                border-color: var(--primary-color) !important;
                background: transparent !important;
                color: var(--primary-color) !important;
            }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                background: var(--primary-color) !important;
                border-color: var(--primary-color) !important;
            }

        @@media (max-width: 768px) {
            .management-container {
                padding: 0 0.5rem;
            }

            .management-header {
                flex-direction: column;
                align-items: flex-start;
            }

            .search-container {
                margin-top: 1rem;
                width: 100%;
                max-width: 100%;
            }

            .table td, .table th {
                padding: 0.75rem;
            }

            .action-buttons {
                display: flex;
                flex-wrap: wrap;
                gap: 0.25rem;
            }

            .action-btn {
                margin: 2px;
            }
        }
    </style>
</head>
<body>
    <div class="management-container animate__animated animate__fadeIn">
        <div class="management-header">
            <div>
                <h1 class="h3 mb-0">
                    <i class="fas fa-cog me-2"></i>Equipment Management
                </h1>
                <p class="text-muted mb-0">Manage all equipment in your facility</p>
            </div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-2"></i>Add New Equipment
            </a>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-white">
                        <i class="fas fa-list me-2"></i>Equipment List
                    </h5>
                    <div class="search-container">
                        <div class="input-group">
                            <span class="input-group-text search-icon"><i class="fas fa-search"></i></span>
                            <input type="text" id="customSearch" class="form-control search-input" placeholder="Search equipment...">
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-container">
                <div class="table-responsive">
                    <table id="equipmentTable" class="table table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>Equipment</th>
                                <th>Type</th>
                                <th>Location</th>
                                <th>Model</th>
                                <th>Installed</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="animate__animated animate__fadeIn">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="equipment-icon">
                                                <i class="@GetIconForEquipmentType(item.EquipmentType)"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold">@item.EquipmentIdentifier</div>
                                                <div class="text-muted small">@item.Manufacturer</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.EquipmentType</td>
                                    <td>@item.Location</td>
                                    <td>@item.Model</td>
                                    <td>@item.InstallationDate?.ToString("d")</td>
                                    <td>
                                        @{
                                            var statusClass = "badge-active";
                                            var statusText = "Active";
                                            if (item.InstallationDate < DateTime.Now.AddYears(-10))
                                            {
                                                statusClass = "badge-warning";
                                                statusText = "Aging";
                                            }
                                        }
                                        <span class="status-badge @statusClass">@statusText</span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="action-btn btn-details" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" title="Delete">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                            <a asp-action="GenerateQRCode" asp-route-id="@item.Id" class="action-btn btn-qr" title="QR Code">
                                                <i class="fas fa-qrcode"></i>
                                            </a>
                                            <a asp-controller="MaintenanceRecords" asp-action="Create" asp-route-equipmentId="@item.Id" class="action-btn btn-maintenance" title="Add Maintenance">
                                                <i class="fas fa-tools"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Initialize DataTable
            var table = $('#equipmentTable').DataTable({
                responsive: true,
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "No equipment found",
                    infoFiltered: "(filtered from _MAX_ total entries)",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "<i class='fas fa-chevron-right'></i>",
                        previous: "<i class='fas fa-chevron-left'></i>"
                    }
                },
                initComplete: function () {
                    $('.dataTables_length select').addClass('form-select form-select-sm');
                },
                columnDefs: [
                    { orderable: false, targets: [5, 6] },
                    { className: "text-center", targets: [5, 6] }
                ]
            });

            // Custom search box functionality
            $('#customSearch').on('keyup', function () {
                table.search(this.value).draw();
            });

            // Initialize tooltips
            $('[title]').tooltip({
                placement: 'top',
                trigger: 'hover'
            });

            // Show success message if coming from successful action
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('success')) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: urlParams.get('success'),
                    timer: 2000,
                    showConfirmButton: false
                });
            }

            // Add animation to table rows
            $('#equipmentTable tbody tr').each(function(index) {
                $(this).css('animation-delay', `${index * 0.05}s`);
            });
        });
    </script>
</body>
</html>

@functions {
    string GetIconForEquipmentType(EquipmentType type)
    {
        return type switch
        {
            EquipmentType.Transformer => "fas fa-bolt",
            EquipmentType.Generator => "fas fa-gas-pump",
            EquipmentType.WaterPlant => "fas fa-tint",
            EquipmentType.ROPlant => "fas fa-filter",
            EquipmentType.STPlant => "fas fa-recycle",
            EquipmentType.FireSystem => "fas fa-fire-extinguisher",
            EquipmentType.ACIndoorUnit => "fas fa-snowflake",
            EquipmentType.ACOutdoorUnit => "fas fa-fan",
            _ => "fas fa-cog"
        };
    }
}